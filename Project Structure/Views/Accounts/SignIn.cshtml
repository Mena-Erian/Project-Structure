@{
	Layout = "_AuthLayout";
	ViewData["Title"] = "SignIn";
}

<section class="d-flex justify-content-center align-items-center mt-5">
	<div class="p-5 bg-primary rounded-2 text-white">
		<h1 class="bg-success text-center">Welcome in Sign in Page</h1>
		<form class="pt-2">
			<h2 class="mt-2">Sign In</h2>
			<div class="form-floating mb-3">
				<input type="email"
					   class="form-control"
					   id="email"
					   placeholder="name@example.com" />
				<label for="email">Email address</label>
			</div>
			<div class="form-floating">
				<input type="password"
					   class="form-control"
					   id="pass"
					   placeholder="Password" />
				<label for="pass">Password</label>
			</div>

			<button class="btn btn-warning mt-3 ms-auto d-block"
					type="submit">
				Submit
			</button>
		</form>
	</div>
</section>
